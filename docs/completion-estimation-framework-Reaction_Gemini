```python
import re

leads = df[df['in_leads_sheet'] == 1].copy()

def classify_lead(row):
    desc = str(row['description']).lower()
    app_type = str(row['app_type'])
    app_size = str(row['app_size'])
    
    # C0a & C0b
    if app_type == 'Conditions' or 'discharge' in desc or 'pursuant' in desc or 'condition' in desc:
        if desc.startswith('variation of condition') or 'variation of condition' in desc or 'section 73' in desc or 's73' in desc:
            return 'C0b_Variation'
        if 'pursuant' in desc or 'discharge' in desc or 'details submitted' in desc or app_type == 'Conditions':
            return 'C0a_Discharge'
            
    # C5: Demolition + redevelopment
    if 'demolition' in desc and ('erection' in desc or 'construction' in desc or 'redevelopment' in desc or 'dwelling' in desc):
        return 'C5_Demolition_Redev'
        
    # C6: Commercial / institutional
    comm_keywords = ['office', 'school', 'hotel', 'care home', 'commercial', 'retail', 'restaurant', 'pub', 'nursery', 'community centre']
    if any(k in desc for k in comm_keywords):
        return 'C6_Commercial'
        
    # C7: Medium / Large app_size
    if app_size in ['Medium', 'Large']:
        return 'C7_Med_Large'
        
    # C4: Small new-build
    if ('erection of' in desc or 'construction of' in desc or 'new dwelling' in desc or 'new house' in desc or 'new building' in desc) and 'extension' not in desc:
        return 'C4_New_Build'
        
    # C3: Conversion / change of use
    if 'conversion' in desc or 'change of use' in desc:
        return 'C3_Conversion'
        
    # C2: Larger householder
    c2_keywords = ['two storey', 'two-storey', '2 storey', '2-storey', 'basement', 'multi-storey', 'part two']
    if any(k in desc for k in c2_keywords):
        return 'C2_Large_Householder'
        
    # C1: Small householder
    c1_keywords = ['extension', 'dormer', 'loft', 'roof', 'outbuilding', 'porch', 'single storey', 'single-storey']
    if any(k in desc for k in c1_keywords):
        return 'C1_Small_Householder'
        
    return 'C_Other_Fallback'

leads['category'] = leads.apply(classify_lead, axis=1)
print(leads['category'].value_counts())


